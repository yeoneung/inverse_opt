{
  "folded_controls.tex": [
    {
      "before": "$0,\\pm e_j$",
      "after": "$0,\\pm \\boldsymbol{e}_j$"
    },
    {
      "before": "$a$",
      "after": "$\\boldsymbol{a}$"
    },
    {
      "before": "$\\|u\\|\\le1$",
      "after": "$\\|\\boldsymbol{u}\\|\\le1$"
    },
    {
      "before": "\\[\n \\|\\Phi(u)-a\\|^2\\le\\|a\\|^2+\\max\\{0,1-2\\min_i a_i\\}.\n\\]",
      "after": "\\[\n \\|\\Phi(\\boldsymbol{u})-\\boldsymbol{a}\\|^2\\le\\|\\boldsymbol{a}\\|^2+\\max\\{0,1-2\\min_i a_i\\}.\n\\]"
    },
    {
      "before": "$a^\\top\\Phi(u)\\ge(\\min_i a_i)\\|u\\|_1\n\\ge(\\min_i a_i)\\|u\\|$",
      "after": "$\\boldsymbol{a}^\\top\\Phi(\\boldsymbol{u})\\ge(\\min_i a_i)\\|\\boldsymbol{u}\\|_1\n\\ge(\\min_i a_i)\\|\\boldsymbol{u}\\|$"
    }
  ],
  "smooth_curvature_experiment.tex": [
    {
      "before": "$U_X(z,1)=(\\norm z-1)^2/2$",
      "after": "$U_X(\\boldsymbol{z},1)=(\\norm {\\boldsymbol{z}}-1)^2/2$"
    }
  ],
  "appendix_computational_details.tex": [
    {
      "before": "$d$",
      "after": "$\\boldsymbol{d}$"
    },
    {
