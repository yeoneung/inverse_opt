      "before": "$\\zeta^{\\rm ctx}$",
      "after": "$\\boldsymbol{\\zeta}^{\\rm ctx}$"
    },
    {
      "before": "$A_{\\rm cap}$",
      "after": "$\\boldsymbol{A}_{\\rm cap}$"
    },
    {
      "before": "$\\bar x$",
      "after": "$\\boldsymbol{\\bar x}$"
    },
    {
      "before": "$b_{\\rm cap}=A_{\\rm cap}u^{\\rm cap}$",
      "after": "$\\boldsymbol{b}_{\\rm cap}=\\boldsymbol{A}_{\\rm cap}\\boldsymbol{u}^{\\rm cap}$"
    },
    {
      "before": "$u^{\\rm cap}$",
      "after": "$\\boldsymbol{u}^{\\rm cap}$"
    },
    {
      "before": "$\\Phi(v)=\\proj_{\\mathcal X}(c+Gv)$",
      "after": "$\\Phi(\\boldsymbol{v})=\\proj_{\\mathcal X}(\\boldsymbol{c}+\\boldsymbol{G}\\boldsymbol{v})$"
    },
    {
      "before": "$G=0.75Q_p$",
      "after": "$\\boldsymbol{G}=0.75\\boldsymbol{Q}_p$"
    },
