      "after": "$\\boldsymbol{y}^{\\rm src}=0.3\\mathbf1_{\\{\\boldsymbol{d}>0\\}}$"
    },
    {
      "before": "$\\proj_{[0,0.3]^q}(y^{\\rm src}+td)$",
      "after": "$\\proj_{[0,0.3]^q}(\\boldsymbol{y}^{\\rm src}+t\\boldsymbol{d})$"
    },
    {
      "before": "$y^{\\rm src}$",
      "after": "$\\boldsymbol{y}^{\\rm src}$"
    },
    {
      "before": "\\[\n \\Phi(t)=\\proj_{\\mathcal X}(c+td),\\qquad\n \\mathcal X=\\{x:0\\le x\\le\\bar x,\\ A_{\\rm cap}x\\le b_{\\rm cap}\\}.\n\\]",
      "after": "\\[\n \\Phi(t)=\\proj_{\\mathcal X}(\\boldsymbol{c}+t\\boldsymbol{d}),\\qquad\n \\mathcal X=\\{\\boldsymbol{x}:0\\le \\boldsymbol{x}\\le\\boldsymbol{\\bar x},\\ \\boldsymbol{A}_{\\rm cap}\\boldsymbol{x}\\le \\boldsymbol{b}_{\\rm cap}\\}.\n\\]"
    },
    {
      "before": "$c=y^{\\rm src}+0.25\\zeta^{\\rm ctx}$",
      "after": "$\\boldsymbol{c}=\\boldsymbol{y}^{\\rm src}+0.25\\boldsymbol{\\zeta}^{\\rm ctx}$"
