      "before": "$Q_p$",
      "after": "$\\boldsymbol{Q}_p$"
    },
    {
      "before": "$y^{\\rm src}=0.3\\mathbf1_q$",
      "after": "$\\boldsymbol{y}^{\\rm src}=0.3\\mathbf1_q$"
    },
    {
      "before": "$c^{\\rm src}=y^{\\rm src}+|G|\\mathbf1_p$",
      "after": "$\\boldsymbol{c}^{\\rm src}=\\boldsymbol{y}^{\\rm src}+|\\boldsymbol{G}|\\mathbf1_p$"
    },
    {
      "before": "$|G|$",
      "after": "$|\\boldsymbol{G}|$"
    },
    {
      "before": "$c^{\\rm src}+Gv\\ge y^{\\rm src}$",
      "after": "$\\boldsymbol{c}^{\\rm src}+\\boldsymbol{G}\\boldsymbol{v}\\ge \\boldsymbol{y}^{\\rm src}$"
    },
    {
      "before": "$v\\in V$",
      "after": "$\\boldsymbol{v}\\in V$"
    }
